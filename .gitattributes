# Line endings are normalised to LF in the repo and on checkout, so a
# contributor's core.autocrlf setting can't turn a one-line edit into a
# whole-file diff.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.mp4   binary
*.woff  binary
*.woff2 binary
